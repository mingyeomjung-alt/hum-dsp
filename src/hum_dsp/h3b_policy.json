  "known_limits": [
    "wanted_content_in_selected_bands_can_be_attenuated",
    "fixed_RMS_reference_can_miss_hum_only_in_quieter_channel",
    "non_audio_WAV_metadata_is_not_preserved",
    "bounded_DSP_and_IO_buffers_are_not_a_realtime_or_total_process_memory_guarantee",
    "44k_long_conversion_other_formats_listening_and_standalone_distribution_remain"
  ]
}
